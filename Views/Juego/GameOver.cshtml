@{
    ViewData["Title"] = "Game Over";
}

<div class="game-over">

    <h1>GAME OVER</h1>

    <h2>A GANÓ</h2>

    <p>
        No lograste escapar esta vez.
    </p>

    <p>
        A todavía tiene el control.
    </p>

    <a asp-controller="Juego"
       asp-action="Identificacion"
       class="btn-game-over btn-primary">
        TRY AGAIN
    </a>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn-game-over btn-secondary">
        Volver al inicio
    </a>

</div>