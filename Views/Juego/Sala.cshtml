@model TP06.Models.Sala

@{
    ViewData["Title"] = "Sala";
}

<div class="sala-page">
    <header class="sala-header">
        <h2>SALA @Model.Orden</h2>
        <h1>@Model.Nombre</h1>
    </header>

    <div class="sala-hero">
        <section class="sala-texto">
            <h3>Historia</h3>
            <p class="sala-descripcion">
                @Model.Descripcion
            </p>
        </section>

    <img src="~/Imagenes/@Model.Imagenes"
     alt="@Model.Nombre"
     class="imagenSala" />
    </div>

    @if (Model.Orden == 1)
    {
        <h3>Investigá la habitación</h3>
        <ul class="sala-list">
            <li class="sala-item">Teléfono</li>
            <li class="sala-item">Fotos</li>
            <li class="sala-item">Cuaderno</li>
            <li class="sala-item">Candado</li>
            <li class="sala-item">Vela</li>
        </ul>
    }

    @if (Model.Orden == 2)
    {
        <h3>Investigá los mensajes</h3>
        <ul class="sala-list">
            <li class="sala-item">Celular</li>
            <li class="sala-item">Mensajes de A</li>
            <li class="sala-item">Números escondidos</li>
        </ul>
    }

  @if (Model.Orden == 3)
{
    <h3>Investigá la habitación de Alison</h3>

    <ul class="sala-list">
        <li class="sala-item">Muñeca</li>
        <li class="sala-item">Diario</li>
        <li class="sala-item">Fotos</li>
        <li class="sala-item">Espejo</li>
        <li class="sala-item">Caja</li>
    </ul>

    <div class="ahorcado">

        <h3>Mensaje de A</h3>

        <p>
            A dejó una palabra escondida.
            Descubrila para saber dónde buscar.
        </p>

        <div id="palabraOculta">
            _ _ _ _ _ _
        </div>

        <div>
            <label for="letra">Arriesgá una letra:</label>

            <input id="letra"
                   type="text"
                   maxlength="1" />

            <button type="button"
                    class="btn-sala btn-primary-sala"
                    onclick="ArriesgarLetra()">
                ARRIESGAR
            </button>
        </div>

        <div id="ChancesRestantes">
            Intentos restantes: 10
        </div>

        <div id="mensaje"></div>

        <!-- Palabra que tiene que descubrir -->
        <input id="palabra"
               type="hidden"
               value="DIARIO" />

        <!-- Formulario oculto para perder una vida -->
        <form id="formPerderVida"
              asp-controller="Juego"
              asp-action="PerderVidaAhorcado"
              method="post">

            <input type="hidden"
                   name="idSala"
                   value="@Model.Id" />

        </form>

    </div>
}
    @if (Model.Orden == 4)
    {
        <h3>Investigá las pistas</h3>
        <ul class="sala-list">
            <li class="sala-item">Fotografías</li>
            <li class="sala-item">Fechas</li>
            <li class="sala-item">Lugares</li>
            <li class="sala-item">Pistas</li>
        </ul>
    }

    @if (Model.Orden == 5)
    {
        <h3>El juego final</h3>
        <p>
            Recordá todo lo que descubriste en las habitaciones anteriores.
        </p>

        <p>Ingresá el código final.</p>
    }

    <h3>Ingresá la clave</h3>

    <form asp-controller="Juego"
          asp-action="EnviarRespuesta"
          method="post"
          class="sala-form">

        <input type="hidden"
               name="idSala"
               value="@Model.Id" />

        <input type="text"
               name="respuesta"
               placeholder="Clave..." />

        <button type="submit" class="btn-sala btn-primary-sala">
            ENVIAR
        </button>

    </form>
    

    @if (ViewBag.Error != null)
    {
        <p class="error-message">@ViewBag.Error</p>
    }

    <br />

   <a asp-controller="Juego"
   asp-action="PedirPista"
   asp-route-idSala="@Model.Id"
   class="btn-sala btn-pista">
    PEDIR PISTA
</a>

@if (ViewBag.Pista != null)
{
    <p class="pista-mensaje">
        @ViewBag.Pista
    </p>
}
</div>

<script src="~/js/ahorcado.js"></script>