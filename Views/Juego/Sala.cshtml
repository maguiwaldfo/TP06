@model TP06.Models.Sala

<h1>@Model.Nombre</h1>

<p>@Model.Descripcion</p>

<form method="post" asp-controller="Juego" asp-action="EnviarRespuesta">

    <input type="hidden" name="idSala" value="@Model.Id" />

    <input type="text" name="respuesta" placeholder="Ingresá la respuesta" />

    <button type="submit">Enviar</button>

</form>